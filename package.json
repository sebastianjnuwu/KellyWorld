{
  "name": "SoulKitten",
  "version": "02.05.2025",
  "private": true,
  "description": "simple discord bot",
  "main": "build/src/main.js",
  "author": "sebastianjnuwu <sebastianjnuwu@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json -w",
    "start": "node build/src/main.js",
    "dev": "tsnd --expose-gc --transpile-only --ignore-watch node_modules --respawn src/main.ts",
    "lint": "npx @biomejs/biome lint --write",
    "format": "npx @biomejs/biome format --write",
    "check": "tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "cz"
  },
  "hooks": {
    "prepare-commit-msg": "npx --no -- commitlint --edit $1; exec < /dev/tty && npx cz --hook || true"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^7.0.0",
    "chalk": "^5.4.1",
    "child_process": "^1.0.2",
    "colors": "^1.4.0",
    "discord.js": "^14.14.1",
    "dotenv": "^17.0.0",
    "i18next": "^26.0.0",
    "i18next-fs-backend": "^2.3.1",
    "ms": "^2.1.3",
    "os": "^0.1.2",
    "prisma": "^7.0.0",
    "undici": "^8.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^24.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastianjnuwu/SoulKitten"
  },
  "bugs": {
    "url": "https://github.com/sebastianjnuwu/SoulKitten/issues"
  },
  "engines": {
    "npm": ">=8",
    "node": ">=18"
  }
}
